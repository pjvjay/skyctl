# skyctl environment configuration
# Copy this to .env and fill in your values.
# Use Bluesky APP PASSWORDS, not your main account password.
# Generate app passwords at: https://bsky.app/settings/app-passwords

# Comma-separated list of account aliases
BSKY_ACCOUNTS=personal,work

# ── personal account ──────────────────────────────────────────────
BSKY_PERSONAL_HANDLE=omnidion.bsky.social
BSKY_PERSONAL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── work account ──────────────────────────────────────────────────
BSKY_WORK_HANDLE=mywork.bsky.social
BSKY_WORK_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Add more accounts by adding to BSKY_ACCOUNTS and adding the
# corresponding BSKY_<ALIAS>_HANDLE and BSKY_<ALIAS>_PASSWORD pairs.
