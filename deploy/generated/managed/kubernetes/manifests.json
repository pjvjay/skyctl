{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "skyctl",
        "labels": {
          "app.kubernetes.io/name": "skyctl",
          "app.kubernetes.io/managed-by": "skyctl-deploy"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "skyctl",
        "namespace": "skyctl",
        "labels": {
          "app.kubernetes.io/name": "skyctl",
          "app.kubernetes.io/managed-by": "skyctl-deploy"
        },
        "annotations": {
          "eks.amazonaws.com/role-arn": "arn:aws:iam::123456789012:role/skyctl-eks"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "skyctl-env",
        "namespace": "skyctl",
        "labels": {
          "app.kubernetes.io/name": "skyctl",
          "app.kubernetes.io/managed-by": "skyctl-deploy"
        }
      },
      "data": {
        "SKYCTL_PLATFORM": "kubernetes",
        "SKYCTL_COMPUTE": "deployment",
        "SKYCTL_SECRETS": "env",
        "SKYCTL_STATE_URL": "s3://my-skyctl-state/skyctl",
        "SKYCTL_QUEUE_URL": "sqs://sqs.us-east-1.amazonaws.com/123456789012/skyctl-work",
        "SKYCTL_DELAYED_URL": "none",
        "SKYCTL_AGENT_MODEL": "anthropic:claude-opus-5-5",
        "SKYCTL_AGENT_ALLOW_WRITES": "true",
        "SKYCTL_AGENT_ALLOW_DELETE": "false",
        "SKYCTL_AGENT_MAX_WRITES": "5",
        "SKYCTL_AGENT_MAX_TURNS": "25",
        "SKYCTL_AGENT_MAX_SECONDS": "540",
        "SKYCTL_AGENT_ACCOUNTS": "work",
        "SKYCTL_LOG_FORMAT": "json",
        "SKYCTL_AUTH": "bearer",
        "SKYCTL_HTTP_MCP": "true",
        "SKYCTL_SEARCH_URL": "gdelt://",
        "SKYCTL_TASKS_FILE": "/etc/skyctl/tasks.toml",
        "AWS_REGION": "us-east-1"
      }
    },
    {
      "apiVersion": "keda.sh/v1alpha1",
      "kind": "TriggerAuthentication",
      "metadata": {
        "name": "skyctl-keda",
        "namespace": "skyctl"
      },
      "spec": {
        "podIdentity": {
          "provider": "aws"
        }
      }
    },
    {
      "apiVersion": "keda.sh/v1alpha1",
      "kind": "ScaledJob",
      "metadata": {
        "name": "skyctl-worker",
        "namespace": "skyctl",
        "labels": {
          "app.kubernetes.io/name": "skyctl",
          "app.kubernetes.io/managed-by": "skyctl-deploy"
        }
      },
      "spec": {
        "jobTargetRef": {
          "backoffLimit": 0,
          "template": {
            "metadata": {
              "labels": {
                "app.kubernetes.io/name": "skyctl",
                "app.kubernetes.io/managed-by": "skyctl-deploy"
              }
            },
            "spec": {
              "serviceAccountName": "skyctl",
              "restartPolicy": "Never",
              "securityContext": {
                "runAsNonRoot": true,
                "runAsUser": 10001,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "containers": [
                {
                  "name": "skyctl",
                  "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/skyctl:1.2.0",
                  "args": [
                    "worker",
                    "--once"
                  ],
                  "envFrom": [
                    {
                      "configMapRef": {
                        "name": "skyctl-env"
                      }
                    },
                    {
                      "secretRef": {
                        "name": "skyctl-secrets"
                      }
                    }
                  ],
                  "env": [
                    {
                      "name": "SKYCTL_COMPUTE",
                      "value": "keda"
                    }
                  ],
                  "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "readOnlyRootFilesystem": true,
                    "capabilities": {
                      "drop": [
                        "ALL"
                      ]
                    }
                  },
                  "resources": {
                    "requests": {
                      "cpu": "250m",
                      "memory": "512Mi"
                    },
                    "limits": {
                      "memory": "512Mi"
                    }
                  },
                  "volumeMounts": [
                    {
                      "name": "tmp",
                      "mountPath": "/tmp"
                    },
                    {
                      "name": "tasks",
                      "mountPath": "/etc/skyctl",
                      "readOnly": true
                    }
                  ]
                }
              ],
              "volumes": [
                {
                  "name": "tmp",
                  "emptyDir": {}
                },
                {
                  "name": "tasks",
                  "configMap": {
                    "name": "skyctl-tasks"
                  }
                }
              ]
            }
          }
        },
        "pollingInterval": 30,
        "maxReplicaCount": 2,
        "triggers": [
          {
            "type": "aws-sqs-queue",
            "metadata": {
              "queueURL": "https://sqs.us-east-1.amazonaws.com/123456789012/skyctl-work",
              "queueLength": "1",
              "awsRegion": "us-east-1"
            },
            "authenticationRef": {
              "name": "skyctl-keda"
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "skyctl-tasks",
        "namespace": "skyctl",
        "labels": {
          "app.kubernetes.io/name": "skyctl",
          "app.kubernetes.io/managed-by": "skyctl-deploy"
        }
      },
      "data": {
        "tasks.toml": "# Rendered by skyctl deploy from the deployment spec. Do not edit by hand.\n\n[tasks.daily-engagement]\ngoal = \"Read the work account's notifications and draft replies to genuine product questions.\"\naccounts = [\"work\"]\nallow_writes = true\nmax_writes = 5\napproval = \"writes\"\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "skyctl-http",
        "namespace": "skyctl",
        "labels": {
          "app.kubernetes.io/name": "skyctl",
          "app.kubernetes.io/managed-by": "skyctl-deploy",
          "app.kubernetes.io/component": "http"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "skyctl",
            "app.kubernetes.io/managed-by": "skyctl-deploy",
            "app.kubernetes.io/component": "http"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "skyctl",
              "app.kubernetes.io/managed-by": "skyctl-deploy",
              "app.kubernetes.io/component": "http"
            }
          },
          "spec": {
            "serviceAccountName": "skyctl",
            "restartPolicy": "Always",
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "skyctl",
                "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/skyctl:1.2.0",
                "args": [
                  "serve"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "skyctl-env"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "skyctl-secrets"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "SKYCTL_COMPUTE",
                    "value": "deployment"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "500m",
                    "memory": "1024Mi"
                  },
                  "limits": {
                    "memory": "1024Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "tasks",
                    "mountPath": "/etc/skyctl",
                    "readOnly": true
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8080,
                    "name": "http"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 30
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              },
              {
                "name": "tasks",
                "configMap": {
                  "name": "skyctl-tasks"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "skyctl-http",
        "namespace": "skyctl",
        "labels": {
          "app.kubernetes.io/name": "skyctl",
          "app.kubernetes.io/managed-by": "skyctl-deploy"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "skyctl",
          "app.kubernetes.io/managed-by": "skyctl-deploy",
          "app.kubernetes.io/component": "http"
        },
        "ports": [
          {
            "port": 80,
            "targetPort": "http",
            "name": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "skyctl-tick",
        "namespace": "skyctl",
        "labels": {
          "app.kubernetes.io/name": "skyctl",
          "app.kubernetes.io/managed-by": "skyctl-deploy"
        }
      },
      "spec": {
        "schedule": "*/5 * * * *",
        "timeZone": "UTC",
        "concurrencyPolicy": "Forbid",
        "startingDeadlineSeconds": 300,
        "successfulJobsHistoryLimit": 1,
        "failedJobsHistoryLimit": 3,
        "jobTemplate": {
          "spec": {
            "backoffLimit": 0,
            "activeDeadlineSeconds": 300,
            "template": {
              "metadata": {
                "labels": {
                  "app.kubernetes.io/name": "skyctl",
                  "app.kubernetes.io/managed-by": "skyctl-deploy"
                }
              },
              "spec": {
                "serviceAccountName": "skyctl",
                "restartPolicy": "Never",
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "containers": [
                  {
                    "name": "skyctl",
                    "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/skyctl:1.2.0",
                    "args": [
                      "invoke",
                      "{\"kind\":\"tick\"}"
                    ],
                    "envFrom": [
                      {
                        "configMapRef": {
                          "name": "skyctl-env"
                        }
                      },
                      {
                        "secretRef": {
                          "name": "skyctl-secrets"
                        }
                      }
                    ],
                    "env": [
                      {
                        "name": "SKYCTL_COMPUTE",
                        "value": "cronjob"
                      }
                    ],
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "readOnlyRootFilesystem": true,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      }
                    },
                    "resources": {
                      "requests": {
                        "cpu": "250m",
                        "memory": "512Mi"
                      },
                      "limits": {
                        "memory": "512Mi"
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "tmp",
                        "mountPath": "/tmp"
                      },
                      {
                        "name": "tasks",
                        "mountPath": "/etc/skyctl",
                        "readOnly": true
                      }
                    ]
                  }
                ],
                "volumes": [
                  {
                    "name": "tmp",
                    "emptyDir": {}
                  },
                  {
                    "name": "tasks",
                    "configMap": {
                      "name": "skyctl-tasks"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "skyctl-daily-engagement",
        "namespace": "skyctl",
        "labels": {
          "app.kubernetes.io/name": "skyctl",
          "app.kubernetes.io/managed-by": "skyctl-deploy"
        }
      },
      "spec": {
        "schedule": "0 9 * * mon-fri",
        "timeZone": "UTC",
        "concurrencyPolicy": "Forbid",
        "startingDeadlineSeconds": 300,
        "successfulJobsHistoryLimit": 1,
        "failedJobsHistoryLimit": 3,
        "jobTemplate": {
          "spec": {
            "backoffLimit": 0,
            "activeDeadlineSeconds": 900,
            "template": {
              "metadata": {
                "labels": {
                  "app.kubernetes.io/name": "skyctl",
                  "app.kubernetes.io/managed-by": "skyctl-deploy"
                }
              },
              "spec": {
                "serviceAccountName": "skyctl",
                "restartPolicy": "Never",
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "containers": [
                  {
                    "name": "skyctl",
                    "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/skyctl:1.2.0",
                    "args": [
                      "invoke",
                      "{\"kind\":\"task.run\",\"slot\":{\"cron\":\"0 9 * * mon-fri\",\"timezone\":\"UTC\"},\"task\":\"daily-engagement\"}"
                    ],
                    "envFrom": [
                      {
                        "configMapRef": {
                          "name": "skyctl-env"
                        }
                      },
                      {
                        "secretRef": {
                          "name": "skyctl-secrets"
                        }
                      }
                    ],
                    "env": [
                      {
                        "name": "SKYCTL_COMPUTE",
                        "value": "cronjob"
                      }
                    ],
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "readOnlyRootFilesystem": true,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      }
                    },
                    "resources": {
                      "requests": {
                        "cpu": "250m",
                        "memory": "512Mi"
                      },
                      "limits": {
                        "memory": "512Mi"
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "tmp",
                        "mountPath": "/tmp"
                      },
                      {
                        "name": "tasks",
                        "mountPath": "/etc/skyctl",
                        "readOnly": true
                      }
                    ]
                  }
                ],
                "volumes": [
                  {
                    "name": "tmp",
                    "emptyDir": {}
                  },
                  {
                    "name": "tasks",
                    "configMap": {
                      "name": "skyctl-tasks"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
