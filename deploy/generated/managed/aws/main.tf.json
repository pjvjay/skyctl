{
  "terraform": {
    "required_version": ">= 1.6",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": ">= 5.60"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "us-east-1"
    }
  },
  "variable": {
    "image": {
      "type": "string",
      "description": "Container image (ECR for Lambda).",
      "default": "123456789012.dkr.ecr.us-east-1.amazonaws.com/skyctl:1.2.0"
    },
    "secrets_json": {
      "type": "string",
      "description": "The BSKY_* / API-key map as JSON or dotenv text.",
      "sensitive": true
    },
    "http_token": {
      "type": "string",
      "description": "Bearer token for the HTTP service.",
      "sensitive": true
    }
  },
  "data": {
    "aws_caller_identity": {
      "current": {}
    }
  },
  "resource": {
    "aws_secretsmanager_secret": {
      "config": {
        "name": "skyctl/config",
        "recovery_window_in_days": 7
      },
      "http_token": {
        "name": "skyctl/http-token",
        "recovery_window_in_days": 7
      }
    },
    "aws_secretsmanager_secret_version": {
      "config": {
        "secret_id": "${aws_secretsmanager_secret.config.id}",
        "secret_string": "${var.secrets_json}"
      },
      "http_token": {
        "secret_id": "${aws_secretsmanager_secret.http_token.id}",
        "secret_string": "${var.http_token}"
      }
    },
    "aws_s3_bucket": {
      "state": {
        "bucket_prefix": "skyctl-state-",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_s3_bucket_public_access_block": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "block_public_acls": true,
        "block_public_policy": true,
        "ignore_public_acls": true,
        "restrict_public_buckets": true
      }
    },
    "aws_s3_bucket_server_side_encryption_configuration": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "rule": {
          "apply_server_side_encryption_by_default": {
            "sse_algorithm": "aws:kms"
          }
        }
      }
    },
    "aws_s3_bucket_versioning": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "versioning_configuration": {
          "status": "Enabled"
        }
      }
    },
    "aws_s3_bucket_lifecycle_configuration": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "rule": [
          {
            "id": "expire-run-transcripts",
            "status": "Enabled",
            "filter": {
              "prefix": "skyctl/runs/"
            },
            "expiration": {
              "days": 90
            }
          },
          {
            "id": "expire-write-ledger",
            "status": "Enabled",
            "filter": {
              "prefix": "skyctl/ledger/"
            },
            "expiration": {
              "days": 90
            }
          },
          {
            "id": "expire-old-versions",
            "status": "Enabled",
            "filter": {},
            "noncurrent_version_expiration": {
              "noncurrent_days": 30
            }
          }
        ]
      }
    },
    "aws_s3_object": {
      "tasks": {
        "bucket": "${aws_s3_bucket.state.id}",
        "key": "skyctl/config/tasks.toml",
        "content": "# Rendered by skyctl deploy from the deployment spec. Do not edit by hand.\n\n[tasks.daily-engagement]\ngoal = \"Read the work account's notifications and draft replies to genuine product questions.\"\naccounts = [\"work\"]\nallow_writes = true\nmax_writes = 5\napproval = \"writes\"\n",
        "content_type": "application/toml"
      }
    },
    "aws_sqs_queue": {
      "dlq": {
        "name": "skyctl-work-dlq",
        "message_retention_seconds": 1209600,
        "sqs_managed_sse_enabled": true
      },
      "work": {
        "name": "skyctl-work",
        "visibility_timeout_seconds": 900,
        "sqs_managed_sse_enabled": true,
        "redrive_policy": "{\"deadLetterTargetArn\": \"${aws_sqs_queue.dlq.arn}\", \"maxReceiveCount\": 5}"
      }
    },
    "aws_scheduler_schedule_group": {
      "delayed": {
        "name": "skyctl-delayed"
      }
    },
    "aws_iam_role": {
      "delivery": {
        "name": "skyctl-delivery",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"scheduler.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"
      },
      "task": {
        "name": "skyctl-task",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"
      },
      "execution": {
        "name": "skyctl-execution",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"
      },
      "scheduler": {
        "name": "skyctl-scheduler",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"scheduler.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"
      }
    },
    "aws_iam_role_policy": {
      "delivery": {
        "name": "send-to-work-queue",
        "role": "${aws_iam_role.delivery.id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sqs:SendMessage\",\"Resource\":\"${aws_sqs_queue.work.arn}\"}]}"
      },
      "task": {
        "name": "skyctl",
        "role": "${aws_iam_role.task.id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"secretsmanager:GetSecretValue\",\"Resource\":\"${aws_secretsmanager_secret.config.arn}\"},{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\",\"s3:PutObject\",\"s3:DeleteObject\"],\"Resource\":\"${aws_s3_bucket.state.arn}/*\"},{\"Effect\":\"Allow\",\"Action\":\"s3:ListBucket\",\"Resource\":\"${aws_s3_bucket.state.arn}\"},{\"Effect\":\"Allow\",\"Action\":[\"sqs:SendMessage\",\"sqs:ReceiveMessage\",\"sqs:DeleteMessage\",\"sqs:ChangeMessageVisibility\",\"sqs:GetQueueAttributes\"],\"Resource\":\"${aws_sqs_queue.work.arn}\"},{\"Effect\":\"Allow\",\"Action\":[\"scheduler:CreateSchedule\",\"scheduler:UpdateSchedule\",\"scheduler:DeleteSchedule\"],\"Resource\":\"arn:aws:scheduler:us-east-1:${data.aws_caller_identity.current.account_id}:schedule/skyctl-delayed/*\"},{\"Effect\":\"Allow\",\"Action\":\"iam:PassRole\",\"Resource\":\"${aws_iam_role.delivery.arn}\"},{\"Effect\":\"Allow\",\"Action\":[\"bedrock:InvokeModel\",\"bedrock:InvokeModelWithResponseStream\"],\"Resource\":\"*\"}]}"
      },
      "execution_secrets": {
        "name": "inject-http-token",
        "role": "${aws_iam_role.execution.id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"secretsmanager:GetSecretValue\",\"Resource\":\"${aws_secretsmanager_secret.http_token.arn}\"}]}"
      },
      "scheduler": {
        "name": "run-jobs",
        "role": "${aws_iam_role.scheduler.id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"ecs:RunTask\",\"Resource\":\"${aws_ecs_task_definition.job.arn_without_revision}:*\"},{\"Effect\":\"Allow\",\"Action\":\"iam:PassRole\",\"Resource\":[\"${aws_iam_role.task.arn}\",\"${aws_iam_role.execution.arn}\"]}]}"
      }
    },
    "aws_iam_role_policy_attachment": {
      "execution": {
        "role": "${aws_iam_role.execution.name}",
        "policy_arn": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
      }
    },
    "aws_ecs_cluster": {
      "main": {
        "name": "skyctl",
        "setting": {
          "name": "containerInsights",
          "value": "enabled"
        }
      }
    },
    "aws_cloudwatch_log_group": {
      "main": {
        "name": "/ecs/skyctl",
        "retention_in_days": 30
      }
    },
    "aws_ecs_task_definition": {
      "http": {
        "family": "skyctl-http",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "network_mode": "awsvpc",
        "cpu": "512",
        "memory": "1024",
        "task_role_arn": "${aws_iam_role.task.arn}",
        "execution_role_arn": "${aws_iam_role.execution.arn}",
        "volume": [
          {
            "name": "tmp"
          }
        ],
        "runtime_platform": {
          "operating_system_family": "LINUX",
          "cpu_architecture": "X86_64"
        },
        "container_definitions": "[{\"name\": \"skyctl\", \"image\": \"${var.image}\", \"essential\": true, \"command\": [\"serve\"], \"environment\": [{\"name\": \"SKYCTL_PLATFORM\", \"value\": \"aws\"}, {\"name\": \"SKYCTL_COMPUTE\", \"value\": \"ecs\"}, {\"name\": \"SKYCTL_SECRETS\", \"value\": \"aws-sm://skyctl/config\"}, {\"name\": \"SKYCTL_STATE_URL\", \"value\": \"s3://${aws_s3_bucket.state.bucket}/skyctl\"}, {\"name\": \"SKYCTL_QUEUE_URL\", \"value\": \"sqs://sqs.us-east-1.amazonaws.com/${data.aws_caller_identity.current.account_id}/skyctl-work\"}, {\"name\": \"SKYCTL_DELAYED_URL\", \"value\": \"eventbridge://skyctl-delayed?target=${aws_sqs_queue.work.arn}&role=${aws_iam_role.delivery.arn}\"}, {\"name\": \"SKYCTL_AGENT_MODEL\", \"value\": \"bedrock:anthropic.claude-opus-5-5\"}, {\"name\": \"SKYCTL_AGENT_ALLOW_WRITES\", \"value\": \"true\"}, {\"name\": \"SKYCTL_AGENT_ALLOW_DELETE\", \"value\": \"false\"}, {\"name\": \"SKYCTL_AGENT_MAX_WRITES\", \"value\": \"5\"}, {\"name\": \"SKYCTL_AGENT_MAX_TURNS\", \"value\": \"25\"}, {\"name\": \"SKYCTL_AGENT_MAX_SECONDS\", \"value\": \"540\"}, {\"name\": \"SKYCTL_AGENT_ACCOUNTS\", \"value\": \"work\"}, {\"name\": \"SKYCTL_LOG_FORMAT\", \"value\": \"json\"}, {\"name\": \"SKYCTL_AUTH\", \"value\": \"bearer\"}, {\"name\": \"SKYCTL_HTTP_MCP\", \"value\": \"true\"}, {\"name\": \"SKYCTL_SEARCH_URL\", \"value\": \"gdelt://\"}, {\"name\": \"AWS_REGION\", \"value\": \"us-east-1\"}], \"readonlyRootFilesystem\": true, \"mountPoints\": [{\"sourceVolume\": \"tmp\", \"containerPath\": \"/tmp\", \"readOnly\": false}], \"stopTimeout\": 120, \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"${aws_cloudwatch_log_group.main.name}\", \"awslogs-region\": \"us-east-1\", \"awslogs-stream-prefix\": \"http\"}}, \"secrets\": [{\"name\": \"SKYCTL_HTTP_TOKEN\", \"valueFrom\": \"${aws_secretsmanager_secret.http_token.arn}\"}], \"portMappings\": [{\"containerPort\": 8080, \"protocol\": \"tcp\"}]}]"
      },
      "worker": {
        "family": "skyctl-worker",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "network_mode": "awsvpc",
        "cpu": "512",
        "memory": "1024",
        "task_role_arn": "${aws_iam_role.task.arn}",
        "execution_role_arn": "${aws_iam_role.execution.arn}",
        "volume": [
          {
            "name": "tmp"
          }
        ],
        "runtime_platform": {
          "operating_system_family": "LINUX",
          "cpu_architecture": "X86_64"
        },
        "container_definitions": "[{\"name\": \"skyctl\", \"image\": \"${var.image}\", \"essential\": true, \"command\": [\"worker\"], \"environment\": [{\"name\": \"SKYCTL_PLATFORM\", \"value\": \"aws\"}, {\"name\": \"SKYCTL_COMPUTE\", \"value\": \"ecs\"}, {\"name\": \"SKYCTL_SECRETS\", \"value\": \"aws-sm://skyctl/config\"}, {\"name\": \"SKYCTL_STATE_URL\", \"value\": \"s3://${aws_s3_bucket.state.bucket}/skyctl\"}, {\"name\": \"SKYCTL_QUEUE_URL\", \"value\": \"sqs://sqs.us-east-1.amazonaws.com/${data.aws_caller_identity.current.account_id}/skyctl-work\"}, {\"name\": \"SKYCTL_DELAYED_URL\", \"value\": \"eventbridge://skyctl-delayed?target=${aws_sqs_queue.work.arn}&role=${aws_iam_role.delivery.arn}\"}, {\"name\": \"SKYCTL_AGENT_MODEL\", \"value\": \"bedrock:anthropic.claude-opus-5-5\"}, {\"name\": \"SKYCTL_AGENT_ALLOW_WRITES\", \"value\": \"true\"}, {\"name\": \"SKYCTL_AGENT_ALLOW_DELETE\", \"value\": \"false\"}, {\"name\": \"SKYCTL_AGENT_MAX_WRITES\", \"value\": \"5\"}, {\"name\": \"SKYCTL_AGENT_MAX_TURNS\", \"value\": \"25\"}, {\"name\": \"SKYCTL_AGENT_MAX_SECONDS\", \"value\": \"540\"}, {\"name\": \"SKYCTL_AGENT_ACCOUNTS\", \"value\": \"work\"}, {\"name\": \"SKYCTL_LOG_FORMAT\", \"value\": \"json\"}, {\"name\": \"SKYCTL_AUTH\", \"value\": \"bearer\"}, {\"name\": \"SKYCTL_HTTP_MCP\", \"value\": \"true\"}, {\"name\": \"SKYCTL_SEARCH_URL\", \"value\": \"gdelt://\"}, {\"name\": \"AWS_REGION\", \"value\": \"us-east-1\"}], \"readonlyRootFilesystem\": true, \"mountPoints\": [{\"sourceVolume\": \"tmp\", \"containerPath\": \"/tmp\", \"readOnly\": false}], \"stopTimeout\": 120, \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"${aws_cloudwatch_log_group.main.name}\", \"awslogs-region\": \"us-east-1\", \"awslogs-stream-prefix\": \"worker\"}}}]"
      },
      "job": {
        "family": "skyctl-job",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "network_mode": "awsvpc",
        "cpu": "512",
        "memory": "1024",
        "task_role_arn": "${aws_iam_role.task.arn}",
        "execution_role_arn": "${aws_iam_role.execution.arn}",
        "volume": [
          {
            "name": "tmp"
          }
        ],
        "runtime_platform": {
          "operating_system_family": "LINUX",
          "cpu_architecture": "X86_64"
        },
        "container_definitions": "[{\"name\": \"skyctl\", \"image\": \"${var.image}\", \"essential\": true, \"command\": [\"invoke\", \"{\\\"kind\\\":\\\"tick\\\"}\"], \"environment\": [{\"name\": \"SKYCTL_PLATFORM\", \"value\": \"aws\"}, {\"name\": \"SKYCTL_COMPUTE\", \"value\": \"ecs\"}, {\"name\": \"SKYCTL_SECRETS\", \"value\": \"aws-sm://skyctl/config\"}, {\"name\": \"SKYCTL_STATE_URL\", \"value\": \"s3://${aws_s3_bucket.state.bucket}/skyctl\"}, {\"name\": \"SKYCTL_QUEUE_URL\", \"value\": \"sqs://sqs.us-east-1.amazonaws.com/${data.aws_caller_identity.current.account_id}/skyctl-work\"}, {\"name\": \"SKYCTL_DELAYED_URL\", \"value\": \"eventbridge://skyctl-delayed?target=${aws_sqs_queue.work.arn}&role=${aws_iam_role.delivery.arn}\"}, {\"name\": \"SKYCTL_AGENT_MODEL\", \"value\": \"bedrock:anthropic.claude-opus-5-5\"}, {\"name\": \"SKYCTL_AGENT_ALLOW_WRITES\", \"value\": \"true\"}, {\"name\": \"SKYCTL_AGENT_ALLOW_DELETE\", \"value\": \"false\"}, {\"name\": \"SKYCTL_AGENT_MAX_WRITES\", \"value\": \"5\"}, {\"name\": \"SKYCTL_AGENT_MAX_TURNS\", \"value\": \"25\"}, {\"name\": \"SKYCTL_AGENT_MAX_SECONDS\", \"value\": \"540\"}, {\"name\": \"SKYCTL_AGENT_ACCOUNTS\", \"value\": \"work\"}, {\"name\": \"SKYCTL_LOG_FORMAT\", \"value\": \"json\"}, {\"name\": \"SKYCTL_AUTH\", \"value\": \"bearer\"}, {\"name\": \"SKYCTL_HTTP_MCP\", \"value\": \"true\"}, {\"name\": \"SKYCTL_SEARCH_URL\", \"value\": \"gdelt://\"}, {\"name\": \"AWS_REGION\", \"value\": \"us-east-1\"}], \"readonlyRootFilesystem\": true, \"mountPoints\": [{\"sourceVolume\": \"tmp\", \"containerPath\": \"/tmp\", \"readOnly\": false}], \"stopTimeout\": 120, \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"${aws_cloudwatch_log_group.main.name}\", \"awslogs-region\": \"us-east-1\", \"awslogs-stream-prefix\": \"job\"}}}]"
      }
    },
    "aws_security_group": {
      "alb": {
        "name": "skyctl-alb",
        "vpc_id": "vpc-0123456789abcdef0"
      },
      "task": {
        "name": "skyctl-task",
        "vpc_id": "vpc-0123456789abcdef0"
      }
    },
    "aws_vpc_security_group_ingress_rule": {
      "alb_https": {
        "security_group_id": "${aws_security_group.alb.id}",
        "from_port": 443,
        "to_port": 443,
        "ip_protocol": "tcp",
        "cidr_ipv4": "10.0.0.0/8"
      },
      "task_from_alb": {
        "security_group_id": "${aws_security_group.task.id}",
        "referenced_security_group_id": "${aws_security_group.alb.id}",
        "from_port": 8080,
        "to_port": 8080,
        "ip_protocol": "tcp"
      }
    },
    "aws_vpc_security_group_egress_rule": {
      "alb_to_task": {
        "security_group_id": "${aws_security_group.alb.id}",
        "referenced_security_group_id": "${aws_security_group.task.id}",
        "from_port": 8080,
        "to_port": 8080,
        "ip_protocol": "tcp"
      },
      "task_out": {
        "security_group_id": "${aws_security_group.task.id}",
        "cidr_ipv4": "0.0.0.0/0",
        "ip_protocol": "-1"
      }
    },
    "aws_lb": {
      "http": {
        "name": "skyctl-http",
        "internal": true,
        "load_balancer_type": "application",
        "security_groups": [
          "${aws_security_group.alb.id}"
        ],
        "subnets": [
          "subnet-0123456789abcdef0",
          "subnet-0fedcba9876543210"
        ],
        "drop_invalid_header_fields": true
      }
    },
    "aws_lb_target_group": {
      "http": {
        "name": "skyctl-http",
        "port": 8080,
        "protocol": "HTTP",
        "target_type": "ip",
        "vpc_id": "vpc-0123456789abcdef0",
        "health_check": {
          "path": "/healthz",
          "matcher": "200"
        }
      }
    },
    "aws_lb_listener": {
      "https": {
        "load_balancer_arn": "${aws_lb.http.arn}",
        "port": 443,
        "protocol": "HTTPS",
        "ssl_policy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "certificate_arn": "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000",
        "default_action": {
          "type": "forward",
          "target_group_arn": "${aws_lb_target_group.http.arn}"
        }
      }
    },
    "aws_ecs_service": {
      "http": {
        "name": "skyctl-http",
        "cluster": "${aws_ecs_cluster.main.id}",
        "task_definition": "${aws_ecs_task_definition.http.arn}",
        "desired_count": 1,
        "launch_type": "FARGATE",
        "network_configuration": {
          "subnets": [
            "subnet-0123456789abcdef0",
            "subnet-0fedcba9876543210"
          ],
          "security_groups": [
            "${aws_security_group.task.id}"
          ],
          "assign_public_ip": true
        },
        "load_balancer": {
          "target_group_arn": "${aws_lb_target_group.http.arn}",
          "container_name": "skyctl",
          "container_port": 8080
        },
        "depends_on": [
          "aws_lb_listener.https"
        ]
      },
      "worker": {
        "name": "skyctl-worker",
        "cluster": "${aws_ecs_cluster.main.id}",
        "task_definition": "${aws_ecs_task_definition.worker.arn}",
        "desired_count": 0,
        "launch_type": "FARGATE",
        "network_configuration": {
          "subnets": [
            "subnet-0123456789abcdef0",
            "subnet-0fedcba9876543210"
          ],
          "security_groups": [],
          "assign_public_ip": true
        },
        "lifecycle": {
          "ignore_changes": [
            "desired_count"
          ]
        }
      }
    },
    "aws_appautoscaling_target": {
      "worker": {
        "max_capacity": 2,
        "min_capacity": 0,
        "resource_id": "service/${aws_ecs_cluster.main.name}/${aws_ecs_service.worker.name}",
        "scalable_dimension": "ecs:service:DesiredCount",
        "service_namespace": "ecs"
      }
    },
    "aws_appautoscaling_policy": {
      "worker_up": {
        "name": "skyctl-worker_up",
        "policy_type": "StepScaling",
        "resource_id": "${aws_appautoscaling_target.worker.resource_id}",
        "scalable_dimension": "${aws_appautoscaling_target.worker.scalable_dimension}",
        "service_namespace": "${aws_appautoscaling_target.worker.service_namespace}",
        "step_scaling_policy_configuration": {
          "adjustment_type": "ExactCapacity",
          "cooldown": 60,
          "metric_aggregation_type": "Maximum",
          "step_adjustment": [
            {
              "metric_interval_lower_bound": 0,
              "scaling_adjustment": 2
            }
          ]
        }
      },
      "worker_down": {
        "name": "skyctl-worker_down",
        "policy_type": "StepScaling",
        "resource_id": "${aws_appautoscaling_target.worker.resource_id}",
        "scalable_dimension": "${aws_appautoscaling_target.worker.scalable_dimension}",
        "service_namespace": "${aws_appautoscaling_target.worker.service_namespace}",
        "step_scaling_policy_configuration": {
          "adjustment_type": "ExactCapacity",
          "cooldown": 60,
          "metric_aggregation_type": "Maximum",
          "step_adjustment": [
            {
              "metric_interval_upper_bound": 0,
              "scaling_adjustment": 0
            }
          ]
        }
      }
    },
    "aws_cloudwatch_metric_alarm": {
      "queue_has_work": {
        "alarm_name": "skyctl-queue-has-work",
        "namespace": "AWS/SQS",
        "metric_name": "ApproximateNumberOfMessagesVisible",
        "dimensions": {
          "QueueName": "${aws_sqs_queue.work.name}"
        },
        "statistic": "Maximum",
        "period": 60,
        "evaluation_periods": 1,
        "comparison_operator": "GreaterThanThreshold",
        "threshold": 0,
        "alarm_actions": [
          "${aws_appautoscaling_policy.worker_up.arn}"
        ]
      },
      "queue_idle": {
        "alarm_name": "skyctl-queue-idle",
        "comparison_operator": "LessThanOrEqualToThreshold",
        "evaluation_periods": 15,
        "threshold": 0,
        "alarm_actions": [
          "${aws_appautoscaling_policy.worker_down.arn}"
        ],
        "metric_query": [
          {
            "id": "total",
            "expression": "visible + inflight",
            "label": "work",
            "return_data": true
          },
          {
            "id": "visible",
            "metric": {
              "namespace": "AWS/SQS",
              "metric_name": "ApproximateNumberOfMessagesVisible",
              "dimensions": {
                "QueueName": "${aws_sqs_queue.work.name}"
              },
              "period": 60,
              "stat": "Maximum"
            }
          },
          {
            "id": "inflight",
            "metric": {
              "namespace": "AWS/SQS",
              "metric_name": "ApproximateNumberOfMessagesNotVisible",
              "dimensions": {
                "QueueName": "${aws_sqs_queue.work.name}"
              },
              "period": 60,
              "stat": "Maximum"
            }
          }
        ]
      }
    },
    "aws_scheduler_schedule": {
      "tick": {
        "name": "skyctl-tick",
        "group_name": "default",
        "schedule_expression": "cron(0/5 * * * ? *)",
        "schedule_expression_timezone": "UTC",
        "flexible_time_window": {
          "mode": "OFF"
        },
        "target": {
