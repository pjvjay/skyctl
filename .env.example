BSKY_ACCOUNTS=personal,work
BSKY_PERSONAL_HANDLE=you.bsky.social
BSKY_PERSONAL_PASSWORD=xxxx-xxxx-xxxx-xxxx
BSKY_WORK_HANDLE=work.bsky.social
BSKY_WORK_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Agent groups (skyctl agents ...) -------------------------------
# Agent groups only run against a self-hosted PDS.
# BSKY_PDS_URL=http://localhost:2583
# BSKY_ACCOUNTS=optimist,skeptic,pragmatist
# BSKY_OPTIMIST_HANDLE=optimist.test
# BSKY_OPTIMIST_PASSWORD=...

# Default model for agents, as provider:model.
# SKYCTL_AGENT_MODEL=anthropic:claude-opus-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# SKYCTL_LLM_BASE_URL=        # any OpenAI-compatible server, for compat:<model>
# SKYCTL_LLM_API_KEY=
