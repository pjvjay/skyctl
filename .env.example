BSKY_ACCOUNTS=personal,work
BSKY_PERSONAL_HANDLE=you.bsky.social
BSKY_PERSONAL_PASSWORD=xxxx-xxxx-xxxx-xxxx
BSKY_WORK_HANDLE=work.bsky.social
BSKY_WORK_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Agents (skyctl agents ...) -------------------------------------
# Agents only run against a self-hosted PDS.
# BSKY_PDS_URL=http://localhost:2583
# BSKY_ACCOUNTS=olive,sam,priya
# BSKY_OLIVE_HANDLE=olive.test
# BSKY_OLIVE_PASSWORD=...

# Default model for agents, as provider:model.
# SKYCTL_AGENT_MODEL=anthropic:claude-opus-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# SKYCTL_LLM_BASE_URL=        # any OpenAI-compatible server, for compat:<model>
# SKYCTL_LLM_API_KEY=

# --- Cloud deployment (see docs/CLOUD_FRAMEWORK.md) ------------------------
# Leave unset for local use. URL-style values select the adapter. In the cloud
# these are rendered for you by `skyctl deploy render`.
# SKYCTL_PLATFORM=gcp                          # auto-detected; local|compose|aws|azure|gcp|kubernetes
# SKYCTL_COMPUTE=cloud-run                     # auto-detected; see `skyctl platform list`
# SKYCTL_QUEUE_URL=sqs://sqs.us-east-1.amazonaws.com/123456789012/skyctl-work
#                                              # azqueue://<storage-account>/<queue> | pubsub://<project>/<topic>?subscription=… | servicebus://<ns>/<queue>
# SKYCTL_DELAYED_URL=none                      # queue | eventbridge://<group>?target=<arn>&role=<arn> | cloudtasks://<project>/<loc>/<queue>?url=…&sa=…
# SKYCTL_AUTH=bearer                           # inbound auth chain: bearer,google-oidc,entra-oidc,oidc,aws-alb,easyauth,platform
# SKYCTL_OIDC_AUDIENCE=                        # comma list, for the *-oidc methods
# SKYCTL_OIDC_ALLOWED=                         # comma list of allowed emails / subjects / object ids
# SKYCTL_AGENT_MAX_SECONDS=600                 # keep below the platform's delivery deadline
# SKYCTL_SECRETS=aws-sm://skyctl/config        # azure-kv://<vault>/<secret> | gcp-sm://<project>/<secret>
# SKYCTL_STATE_URL=s3://bucket/skyctl          # az://container/skyctl | gs://bucket/skyctl | file://./.skyctl
# SKYCTL_HTTP_TOKEN=                           # bearer token for `skyctl serve`
# SKYCTL_AGENT_ALLOW_WRITES=false              # task-agent ceilings for this deployment
# SKYCTL_AGENT_ALLOW_DELETE=false
# SKYCTL_AGENT_MAX_WRITES=5
# SKYCTL_AGENT_ACCOUNTS=work

# Cloud-hosted models for SKYCTL_AGENT_MODEL:
#   bedrock:anthropic.claude-opus-5-5      AWS_REGION (task role provides credentials)
#   vertex:claude-opus-5-5                 GOOGLE_CLOUD_PROJECT, CLOUD_ML_REGION
#   azure-openai:<deployment>              AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_KEY
#   foundry:<deployment>                   FOUNDRY_BASE_URL, FOUNDRY_API_KEY

# --- MCP server for agents (see docs/MCP_AGENT.md) ------------------------
# SKYCTL_MCP_PROFILE=plan          # read | plan | direct | admin (HTTP default: plan)
# SKYCTL_MCP_APPROVAL=out_of_band  # none | client | elicit | out_of_band (HTTP default: out_of_band)
# SKYCTL_MCP_STATEFUL=false        # true: enables elicitation/progress over HTTP (needs session affinity)
# SKYCTL_MCP_ALLOWED_HOSTS=        # e.g. mcp.example.com,*.run.app (Host header allow-list)
# SKYCTL_APPROVER_TOKEN=           # a separate bearer token that may approve plans (not the agent's)
# SKYCTL_PLAN_APPROVERS=           # OIDC subjects/emails allowed to approve plans
# SKYCTL_PLAN_LINK_ALLOWLIST=      # e.g. example.com: plans may only publish links to these domains
