include LICENSE NOTICE AUTHORS README.md CHANGELOG.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md GOVERNANCE.md RELEASING.md
include pyproject.toml MANIFEST.in Dockerfile docker-compose.yml .dockerignore .env.example .pre-commit-config.yaml
include agents.example.toml tasks.example.toml
graft skyctl
graft tests
graft docs
graft scripts
graft deploy
graft .github
global-exclude __pycache__ *.py[cod] *.so .DS_Store *.tfstate* .terraform
prune deploy/**/.terraform
